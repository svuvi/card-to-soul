[Unit]
Description=card-to-soul definition proxy
After=network.target

[Service]
Type=simple
User=clawdich
WorkingDirectory=/home/clawdich/projects/card-to-soul/proxy-rs
ExecStart=/home/clawdich/projects/card-to-soul/proxy-rs/target/release/card-proxy
Environment=PORT=3131
Environment=STORE_DIR=/var/lib/card-proxy
Environment=PUBLIC_URL=https://soul.svuvi.ch/proxy
Restart=on-failure

[Install]
WantedBy=multi-user.target
