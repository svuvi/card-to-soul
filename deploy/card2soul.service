[Unit]
Description=card2soul definition proxy
After=network.target

[Service]
Type=simple
User=clawdich
WorkingDirectory=/home/clawdich/projects/card-to-soul
ExecStart=/home/clawdich/projects/card-to-soul/target/release/card2soul
Environment=PORT=3131
Environment=STORE_DIR=/var/lib/card-proxy
Environment=PUBLIC_URL=https://soul.svuvi.ch/proxy
Restart=on-failure

[Install]
WantedBy=multi-user.target
